gFang SC\",\"Hiragino Sans GB\",\"Microsoft YaHei\",system-ui,sans-serif;font-size:6rem;font-weight:800;line-height:1;color:rgba(159,227,198,.13)}\n\n  /* 步骤 */\n  .steps{display:grid;gap:0;grid-template-columns:1fr;counter-reset:step;border-top:1px solid var(--line)}\n  .step{display:grid;grid-template-columns:auto 1fr;gap:16px;padding:20px 0;border-bottom:1px dashed var(--line)}\n  .step .idx{font-family:\"PingFang SC\",\"Hiragino Sans GB\",\"Microsoft YaHei\",system-ui,sans-serif;font-size:1.5rem;font-weight:800;color:var(--mint-deep);line-height:1.2}\n  .step h3{margin-bottom:.25em;font-size:1.02rem}\n  .step p{margin:0;color:var(--brown-3);font-size:.95rem}\n\n  /* FAQ 折叠 */\n  .faq details{border-bottom:1px solid var(--line);padding:2px 0}\n  .faq details:first-of-type{border-top:1px solid var(--line)}\n  .faq summary{list-style:none;cursor:pointer;display:flex;gap:14px;align-items:flex-start;padding:16px 30px 16px 0;position:relative;font-family:\"PingFang SC\",\"Hiragino Sans GB\",\"Microsoft YaHei\",system-ui,sans-serif;font-weight:600;color:var(--brown);font-size:1rem}\n  .faq summary::-webkit-details-marker{display:none}\n  .faq summary::after{content:\"+\";position:absolute;right:4px;top:13px;font-size:1.4rem;color:var(--mint-deep);font-weight:400;line-height:1}\n  .faq details[open] summary::after{content:\"−\"}\n  .faq summary q{quotes:\"Q \" \" \";color:var(--mint-deep);font-weight:700;font-family:\"PingFang SC\",\"Hiragino Sans GB\",\"Microsoft YaHei\",system-ui,sans-serif}\n  .faq .ans{padding:0 30px 18px 0;color:var(--brown-3);font-size:.96rem}\n  .faq .ans p:last-child{margin-bottom:0}\n  .faq .ans q{quotes:\"A \" \" \";color:var(--brown);font-weight:700;font-family:\"PingFang SC\",\"Hiragino Sans GB\",\"Microsoft YaHei\",system-ui,sans-serif}\n\n  /* 收尾 */\n  .closing{background:var(--brown);color:var(--cream);border-bottom:none;padding:48px 0}\n  .closing h2{color:var(--mint)}\n  .closing p{color:var(--cream-2);max-width:44em}\n  .closing .wrap{display:grid;gap:22px}\n  .closing .jump{display:flex;flex-wrap:wrap;gap:10px;font-family:\"PingFang SC\",\"Hiragino Sans GB\",\"Microsoft YaHei\",system-ui,sans-serif;font-size:13.5px}\n  .closing .jump a{color:var(--mint);border:1px solid rgba(159,227,198,.5);padding:5px 12px}\n  .closing .jump a:hover{background:var(--mint);color:var(--brown)}\n  footer{background:var(--brown-2);color:rgba(244,237,228,.62);font-family:\"PingFang SC\",\"Hiragino Sans GB\",\"Microsoft YaHei\",system-ui,sans-serif;font-size:12.5px;letter-spacing:.05em;padding:18px 0}\n  footer .wrap{display:flex;flex-wrap:wrap;gap:8px 18px;justify-content:space-between}\n\n  @media (min-width:720px){\n    .hero{padding:72px 0 56px}\n    .hero-grid{grid-template-columns:minmax(0,1.55fr) minmax(0,1fr);gap:44px;align-items:start}\n    .hero-body{margin-top:22px}\n    .cards{grid-template-columns:repeat(2,1fr)}\n    .cards .card:nth-child(3){grid-column:1 / -1}\n    .client-grid{grid-template-columns:repeat(2,1fr)}\n    .client-grid .client:first-child{grid-column:1 / -1}\n    .plan ul{columns:2;column-gap:34px}\n    .plan li{break-inside:avoid}\n  }\n  @media (min-width:960px){\n    body{font-size:18px}\n    .cards{grid-template-columns:repeat(3,1fr)}\n    .cards .card:nth-child(3){grid-column:auto}\n    .client-grid{grid-template-columns:repeat(3,1fr)}\n    .client-grid .client:first-child{grid-column:auto}\n    .faq .ans{padding-right:120px}\n    section{padding:66px 0}\n  }\n</style><div class=\"topbar\">\n  <div class=\"wrap\">\n    <nav class=\"crumb\" aria-label=\"面包屑\">\n      <a href=\"#\">首页</a>\n      <span class=\"sep\">/</span>\n      <strong>快车</strong>\n      <span class=\"sep\">/</span>\n      <span>说明与订阅</span>\n    </nav>\n    <nav class=\"toc\" aria-label=\"页内目录\">\n      <a href=\"#start\">开篇</a>\n      <a href=\"#why\">三条线</a>\n      <a href=\"#plans\">订阅方案</a>\n      <a href=\"#clients\">客户端</a>\n      <a href=\"#how\">怎么开始</a>\n      <a href=\"#faq\">常见问题</a>\n    </nav>\n  </div>\n</div>\n\n<main>\n\n  <header class=\"hero\" id=\"start\">\n    <div class=\"wrap hero-grid\">\n      <div>\n        <div class=\"kicker\">快车 · 说明与订阅</div>\n        <h1>快车：先把问题问清楚，<em>再决定要不要上车</em></h1>\n        <p class=\"lede\">有些东西一眼就能买，比如一杯咖啡；有些东西值得先花十分钟弄明白，比如一个你每天都要用的网络工具。这页写给后者——写给愿意先看清方案、再决定订阅的人。</p>\n        <div class=\"sign\">撰文 / 快车编辑组　阅读约 6 分钟</div>\n      </div>\n      <div class=\"hero-body\">\n        <p>我们不太擅长把一句话说得天花乱坠。所以我们换了个办法：把容易被含糊带过的地方，一条条摊开来讲——多少钱、给多少流量、能连几台设备、年付省下什么、遇到疑问去哪里问。</p>\n        <p>如果你只想知道结论：快车目前提供三档订阅，按月或按年付，按年付的价格写在每张方案卡上。往下翻，你会看到完整的内容；再往下，是一组常被问到的问题。</p>\n      </div>\n    </div>\n  </header>\n\n  <section id=\"why\">\n    <div class=\"wrap\">\n      <div class=\"sec-head\">\n        <span class=\"sec-no\">01 / 三条线</span>\n        <h2>在挑方案之前，先想清楚三件事</h2>\n      </div>\n      <p class=\"sub\">流量、设备数量、使用场合——这三条线基本决定你会落在哪一档方案上。把它们想明白，比反复比较价格更省时间。</p>\n      <div class=\"cards\">\n        <article class=\"card\">\n          <span class=\"tag\">第一条线</span>\n          <h3>你一个月大概用多少</h3>\n          <p>看视频和只收发消息，是两种完全不同的用量。先估一个大概区间，再去对照方案里的流量额度，比先看价格再回头担心够不够用更靠谱。</p>\n          <span class=\"num\">1</span>\n        </article>\n        <article class=\"card\">\n          <span class=\"tag\">第二条线</span>\n          <h3>同时有几台设备</h3>\n          <p>手机、电脑、平板，再加上家里人的设备，很容易超过三台。每档方案都写了设备数量上限，按你手上真实的设备数量来挑，别按理想状态挑。</p>\n          <span class=\"num\">2</span>\n        </article>\n        <article class=\"card\">\n          <span class=\"tag\">第三条线</span>\n          <h3>是自用还是多人共用</h3>\n          <p>一个人用和一个小团队用，需求结构不一样。前者看重顺手，后者看重额度与协同。团队版的存在，就是为了让后一种情况不必硬塞进个人方案。</p>\n          <span class=\"num\">3</span>\n        </article>\n      </div>\n    </div>\n  </section>\n\n  <section id=\"plans\">\n    <div class=\"wrap\">\n      <div class=\"sec-head\">\n        <span class=\"sec-no\">02 / 订阅方案</span>\n        <h2>三档方案，按月付或按年付</h2>\n      </div>\n      <p class=\"sub\">下面三张卡依次排开，权益与价格都写在卡里。按年付的金额直接标在月价下方，方便你一眼比较总支出。方案内容以本页文字为准。</p>\n\n      <article class=\"plan\">\n        <div class=\"plan-top\">\n          <h3>基础版</h3>\n          <span class=\"price\">¥15<small> / 月</small></span>\n        </div>\n        <div class=\"annual\">按年付仅需 ¥150 / 年</div>\n        <ul>\n          <li>每月 100GB 流量额度</li>\n          <li>支持 3 台设备同时在线</li>\n          <li>基础流媒体解锁</li>\n          <li>普通线路节点池</li>\n        </ul>\n      </article>\n\n      <article class=\"plan top\">\n        <div class=\"plan-top\">\n          <h3>旗舰版</h3>\n          <span class=\"pick\">多数人的选择</span>\n          <span class=\"price\">¥35<small> / 月</small></span>\n        </div>\n        <div class=\"annual\">按年付仅需 ¥350 / 年</div>\n        <ul>\n          <li>每月 300GB 流量额度</li>\n          <li>支持 5 台设备同时在线</li>\n          <li>全节点原生流媒体解锁</li>\n          <li>IPLC 专线游戏加速优化</li>\n          <li>7×24 优先工单支持</li>\n        </ul>\n      </article>\n\n      <article class=\"plan\">\n        <div class=\"plan-top\">\n          <h3>团队版</h3>\n          <span class=\"price\">¥85<small> / 月</small></span>\n        </div>\n        <div class=\"annual\">按年付仅需 ¥850 / 年</div>\n        <ul>\n          <li>每月 1000GB 流量额度</li>\n          <li>支持 20 台设备同时在线</li>\n          <li>VIP 专属高带宽节点</li>\n          <li>支持企业定制路由</li>\n          <li>专属客户经理服务</li>\n        </ul>\n      </article>\n    </div>\n  </section>\n\n  <section id=\"clients\">\n    <div class=\"wrap\">\n      <div class=\"sec-head\">\n        <span class=\"sec-no\">03 / 客户端与入口</span>\n        <h2>你会在哪儿用到快车</h2>\n      </div>\n      <p class=\"sub\">客户端的具体形态与下载地址，请以你订阅后收到的说明为准。本页只说明各入口的用途，不提供下载链接，也不承诺任何特定平台的兼容性。</p>\n      <div class=\"client-grid\">\n        <article class=\"client\">\n          <h3>账号与订阅管理</h3>\n          <p>查看当前方案、剩余额度、到期时间与设备数量。续费与方案切换也在这里完成，不需要另开页面。</p>\n          <p>如果你只记得一个入口，记这个就够了。</p>\n          <span class=\"num\">01</span>\n        </article>\n        <article class=\"client\">\n          <h3>客户端使用说明</h3>\n          <p>订阅后你会收到与方案对应的使用说明，里面写清了如何导入配置、如何查看当前连接状态。</p>\n          <p>说明会随方案更新，建议以最新一版为准。</p>\n          <span class=\"num\">02</span>\n        </article>\n        <article class=\"client\">\n          <h3>工单与支持</h3>\n          <p>遇到问题时，工单是最直接的通道。旗舰版与团队版享有优先处理，团队版另有专属客户经理对接。</p>\n          <p>描述问题时附上时间与现象，会比一句“连不上”有用得多。</p>\n          <span class=\"num\">03</span>\n        </article>\n      </div>\n    </div>\n  </section>\n\n  <section id=\"how\">\n    <div class=\"wrap\">\n      <div class=\"sec-head\">\n        <span class=\"sec-no\">04 / 怎么开始</span>\n        <h2>从决定到用上，中间只有四步</h2>\n      </div>\n      <div class=\"steps\">\n        <div class=\"step\">\n          <div class=\"idx\">01</div>\n          <div>\n            <h3>先估自己的用量与设备数</h3>\n            <p>回到上面那三条线。写下来：每月大致流量、常用设备台数、是自用还是多人。这一步做扎实，后面几乎不会选错。</p>\n          </div>\n        </div>\n        <div class=\"step\">\n          <div class=\"idx\">02</div>\n          <div>\n            <h3>对照方案挑一档</h3>\n            <p>三档方案的额度与设备数逐级递增。拿不准时，先按当前需求挑，不必一步到位选最贵的那档。</p>\n          </div>\n        </div>\n        <div class=\"step\">\n          <div class=\"idx\">03</div>\n          <div>\n            <h3>决定按月付还是按年付</h3>\n            <p>按年付的总价写在每张卡上，你可以直接和月价乘十二做个比较，再决定哪种方式更贴合你的使用节奏。</p>\n          </div>\n        </div>\n        <div class=\"step\">\n          <div class=\"idx\">04</div>\n          <div>\n            <h3>按说明完成配置</h3>\n            <p>订阅后按收到的使用说明导入配置，在自己的设备上逐台确认。哪台设备有问题，就在工单里指明是哪一台。</p>\n          </div>\n        </div>\n      </div>\n    </div>\n  </section>\n\n  <section id=\"faq\" class=\"faq\">\n    <div class=\"wrap\">\n      <div class=\"sec-head\">\n        <span class=\"sec-no\">05 / 常见问题</span>\n        <h2>你可能正想问的几件事</h2>\n      </div>\n      <p class=\"sub\">下面每一条点开就能看到答案，不需要跳转到别处。</p>\n\n      <details>\n        <summary>快车的三档方案，最实际的差别是什么？</summary>\n        <div class=\"ans\">\n          <p>差别主要在三个数字上：流量额度、同时在线设备数、以及节点类型。基础版是每月 100GB、3 台设备；旗舰版是 300GB、5 台设备，并包含原生流媒体解锁与 IPLC 专线游戏加速优化；团队版是 1000GB、20 台设备，另有 VIP 专属高带宽节点和企业定制路由。</p>\n        </div>\n      </details>\n\n      <details>\n        <summary>按年付能省多少？怎么算比较直观？</summary>\n        <div class=\"ans\">\n          <p>直接把月价乘十二，再和年付价格对比即可。基础版 ¥15/月，年付 ¥150；旗舰版 ¥35/月，年付 ¥350；团队版 ¥85/月，年付 ¥850。三个数字都摆在方案卡上，不需要另外换算。</p>\n        </div>\n      </details>\n\n      <details>\n        <summary>我一个人用，需要选团队版吗？</summary>\n        <div class=\"ans\">\n          <p>通常不需要。团队版的额度与设备数是为多人共用准备的，如果你只是个人使用，旗舰版在流量与设备数量上通常已经够用。判断标准还是那三条线：用量、设备数、是否共用。</p>\n        </div>\n      </details>\n\n      <details>\n        <summary>设备数量上限是怎么算的？</summary>\n        <div class=\"ans\">\n          <p>按同时在线计算。基础版 3 台、旗舰版 5 台、团队版 20 台，指的是同一时间处于连接状态的设备数量。具体的计入方式，以你订阅后收到的使用说明为准。</p>\n        </div>\n      </details>\n\n      <details>\n        <summary>在哪里下载客户端？</summary>\n        <div class=\"ans\">\n          <p>本页不提供下载链接。客户端的具体形态与获取方式，请以订阅后收到的使用说明为准。我们不在页面上放置外部下载地址，以免你拿到来源不明的文件。</p>\n        </div>\n      </details>\n\n      <details>\n        <summary>遇到问题应该找谁？</summary>\n        <div class=\"ans\">\n          <p>走工单。旗舰版享有 7×24 优先工单支持，团队版另有专属客户经理对接。提交时写明时间、设备与具体现象，能明显缩短来回确认的次数。</p>\n        </div>\n      </details>\n\n      <details>\n        <summary>用了不合适怎么办？</summary>\n        <div class=\"ans\">\n          <p>本页不对退款或试用作出承诺。如果你对方案是否合适没有把握，建议先按月付使用一档，确认流量与设备数够用后，再考虑是否转为按年付。</p>\n        </div>\n      </details>\n\n    </div>\n  </section>\n\n  <section class=\"closing\">\n    <div class=\"wrap\">\n      <h2>想清楚之后，剩下的就简单了</h2>\n      <p>如果你已经知道自己每月大概用多少、手上有几台设备、是不是要和人共用，那么选哪一档其实已经浮出来了。剩下的，只是按月付还是按年付的问题。</p>\n      <nav class=\"jump\" aria-label=\"返回页内区块\">\n        <a href=\"#plans\">回到订阅方案</a>\n        <a href=\"#clients\">看客户端说明</a>\n        <a href=\"#how\">再看四步流程</a>\n        <a href=\"#faq\">回到常见问题</a>\n      </nav>\n    </div>\n  </section>\n\n</main>\n\n<footer>\n  <div class=\"wrap\">\n    <span>快车 · 说明与订阅</span>\n    <span>本页所载方案、价格与权益以页面文字为准</span>\n  </div>\n</footer>",
